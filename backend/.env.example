# Run `python -m app.cli init-config` to create .env with independent random keys.
DATABASE_URL=postgresql+psycopg://vmrb:change-database-password@localhost:5432/vmrb
JWT_SECRET=
ID_ENCRYPTION_KEY=
ID_HASH_KEY=
ACCESS_TOKEN_MINUTES=60
STORAGE_ROOT=./dataset
ALLOW_REGISTRATION=false
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_BYTES=536870912
MAX_VOLUME_VOXELS=64000000
MAX_UNCOMPRESSED_BYTES=805306368

# Complete local checkout/snapshot of https://huggingface.co/nvidia/NV-Segment-CT
# Includes hugging_face_pipeline.py, scripts/, vista3d_pretrained_model/ and weights.
# Leave commented until installed. Docker GPU override mounts the directory at /models/nv-segment-ct.
# NV_SEGMENT_CT_DIR=/models/nv-segment-ct
NV_SEGMENT_DEVICE=cuda:0
# Optional existing custom wrapper, instead of the built-in NVIDIA adapter:
# SEGMENTATION_CALLABLE=your_module:infer
SEGMENTATION_IMAGE_TYPES=["CT"]

# Lung nodule candidate detection runs as a separate GPU inference service.
# It accepts NIfTI CT and returns RAS world-coordinate boxes in cccwhd format.
# LUNG_NODULE_MODEL_URL=http://127.0.0.1:8001
LUNG_NODULE_MODEL_TOKEN=
LUNG_NODULE_MODEL_NAME=MONAI/lung_nodule_ct_detection:0.6.9
LUNG_NODULE_MODEL_TIMEOUT_SECONDS=300
LUNG_NODULE_MAX_FINDINGS=300
# Optional in-process adapter instead of the HTTP service:
# LUNG_NODULE_CALLABLE=your_module:infer

# Fill in your OpenAI-compatible service; base URL normally includes /v1.
# No API key or provider is hard-coded. Leaving these blank yields HTTP 503 on AI requests.
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_CONTEXT_RECORDS=30
AI_MAX_CONTEXT_CHARS=30000
